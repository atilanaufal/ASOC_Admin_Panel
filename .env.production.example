# ==============================================================================
# ASOC ADMIN PANEL - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment & Port Configuration
NODE_ENV=production
PORT=3006
HOSTNAME=127.0.0.1
TZ=Asia/Jakarta

# Better Auth & Security
BETTER_AUTH_SECRET=<SECRET>
BETTER_AUTH_URL=https://IP:PORT
NEXT_PUBLIC_APP_URL=https://IP:PORT
BETTER_AUTH_TRUSTED_ORIGINS=https://IP:PORT

# MySQL Database (auth_db)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SALT=

# Redis (L1 Hot Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (SSOT Multi-Tenant)
MONGODB_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/?authSource=USER&directConnection=true

# Wazuh REST API
WAZUH_NODE1_URL=https://IP:55000
WAZUH_NODE1_USER=
WAZUH_NODE1_PASSWORD=

WAZUH_NODE2_URL=https://IP:55000
WAZUH_NODE2_USER=
WAZUH_NODE2_PASSWORD=

WAZUH_NODE3_URL=https://IP:55000
WAZUH_NODE3_USER=
WAZUH_NODE3_PASSWORD=

# Wazuh OpenSearch Indexer
INDEXER_NODE1_HOST=https://IP:9200
INDEXER_NODE1_USER=
INDEXER_NODE1_PASS=

INDEXER_NODE2_HOST=https://IP:9200
INDEXER_NODE2_USER=
INDEXER_NODE2_PASS=

INDEXER_NODE2_HOST=https://IP:9200
INDEXER_NODE2_USER=
INDEXER_NODE2_PASS=

# DFIR-IRIS Incident Response
IRIS_API_URL=https://IP:443
IRIS_API_KEY=

# VM Execution Config
VM_HOST=127.0.0.1
VM_SSH_USER=ubuntu
EXEC_LOCAL=true
CRON_MANAGER_SECRET
